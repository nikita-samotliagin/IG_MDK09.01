digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.6, ranksep=1.1, bgcolor="white", fontname="PT Sans", pad=0.3];
node [shape=plaintext, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#6c757d", arrowsize=0.8];
role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>role</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Роль</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT COLOR="#1d2733"><B>code</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(20)</FONT></TD><TD PORT="code_r"><FONT COLOR="#0d47a1">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#1d2733">title</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(50)</FONT></TD><TD PORT="title_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>users</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Пользователь</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="login"><FONT COLOR="#1d2733"><B>login</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(50)</FONT></TD><TD PORT="login_r"><FONT COLOR="#0d47a1">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"><FONT COLOR="#1d2733">password_hash</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(255)</FONT></TD><TD PORT="password_hash_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name"><FONT COLOR="#1d2733">full_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(150)</FONT></TD><TD PORT="full_name_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone"><FONT COLOR="#1d2733">phone</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(20)</FONT></TD><TD PORT="phone_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT COLOR="#1d2733">email</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(100)</FONT></TD><TD PORT="email_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT COLOR="#007bff"><B>role_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="role_id_r"><FONT COLOR="#0d47a1">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1d2733">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">DATETIME</FONT></TD><TD PORT="created_at_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR></TABLE>>];
room [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>room</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Помещение (место)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#1d2733">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(100)</FONT></TD><TD PORT="name_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="place"><FONT COLOR="#1d2733">place</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(150)</FONT></TD><TD PORT="place_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity"><FONT COLOR="#1d2733">capacity</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="capacity_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#1d2733">description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">TEXT</FONT></TD><TD PORT="description_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="photo"><FONT COLOR="#1d2733">photo</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(100)</FONT></TD><TD PORT="photo_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR></TABLE>>];
event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>event</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Мероприятие</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#1d2733">title</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(150)</FONT></TD><TD PORT="title_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at"><FONT COLOR="#1d2733">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">DATETIME</FONT></TD><TD PORT="starts_at_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_id"><FONT COLOR="#007bff"><B>room_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="room_id_r"><FONT COLOR="#0d47a1">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#1d2733">description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">TEXT</FONT></TD><TD PORT="description_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR></TABLE>>];
application [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>application</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Заявка</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#007bff"><B>user_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="user_id_r"><FONT COLOR="#0d47a1">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id"><FONT COLOR="#007bff"><B>event_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="event_id_r"><FONT COLOR="#0d47a1">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_type_id"><FONT COLOR="#007bff"><B>payment_type_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="payment_type_id_r"><FONT COLOR="#0d47a1">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status_id"><FONT COLOR="#007bff"><B>status_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="status_id_r"><FONT COLOR="#0d47a1">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1d2733">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">DATETIME</FONT></TD><TD PORT="created_at_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR></TABLE>>];
status [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>status</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Статус</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#1d2733"><B>name</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(50)</FONT></TD><TD PORT="name_r"><FONT COLOR="#0d47a1">UQ</FONT></TD></TR></TABLE>>];
payment_type [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>payment_type</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Способ оплаты</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#1d2733"><B>name</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">VARCHAR(50)</FONT></TD><TD PORT="name_r"><FONT COLOR="#0d47a1">UQ</FONT></TD></TR></TABLE>>];
review [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c3ccd6"><TR><TD COLSPAN="3" BGCOLOR="#0d47a1"><FONT COLOR="white"><B>review</B></FONT><BR/><FONT COLOR="#cfe3ff" POINT-SIZE="10">Отзыв</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#0d47a1"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="id_r"><FONT COLOR="#0d47a1">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="application_id"><FONT COLOR="#007bff"><B>application_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="application_id_r"><FONT COLOR="#0d47a1">FK, UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rating"><FONT COLOR="#1d2733">rating</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">INTEGER</FONT></TD><TD PORT="rating_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="body"><FONT COLOR="#1d2733">body</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">TEXT</FONT></TD><TD PORT="body_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1d2733">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6c757d">DATETIME</FONT></TD><TD PORT="created_at_r"><FONT COLOR="#0d47a1"> </FONT></TD></TR></TABLE>>];
role:id_r:e -> users:role_id:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
users:id_r:e -> application:user_id:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
event:id_r:e -> application:event_id:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
room:id_r:e -> event:room_id:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
status:id_r:e -> application:status_id:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
payment_type:id_r:e -> application:payment_type_id:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
application:id_r:e -> review:application_id:w [label="1 : 0..1", arrowhead=crow, arrowtail=tee, dir=both, fontcolor="#0d47a1"];
{rank=same; role; room;}
{rank=same; users; event; status; payment_type;}
}
